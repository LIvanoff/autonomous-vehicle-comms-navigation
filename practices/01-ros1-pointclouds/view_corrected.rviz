Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 60
    - Class: rviz/PointCloud2
      Name: Corrected cloud
      Enabled: true
      Topic: /points_corrected
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Queue Size: 10
  Global Options:
    Fixed Frame: lidar_level
    Background Color: 35; 40; 50
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 35
      Pitch: 0.6
      Yaw: 0.8
